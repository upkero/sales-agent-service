# Copy this file to .env and adjust the values for your environment.
#
# The only value you must supply is OPS_CORE_API_KEY — the key of the ops-core-api
# instance that holds the price list. Everything else has a working default.

# +--------------------------------------------------------------------------+
# | OPS-CORE-API  (the price list)                                            |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.core_api.CoreApiSettings.
# Every /api/v1 endpoint of ops-core-api requires this key. Required: without it
# the service starts and answers the first prospect with a 401.
# The placeholder below is the same in all five services of the portfolio, so
# `cp .env.example .env` gives a working local demo. Change it everywhere at once.
OPS_CORE_API_KEY="change-me-min-16-chars"

# Inside docker compose the host is reachable as host.docker.internal; running the
# service directly on your machine, use localhost.
OPS_CORE_BASE_URL="http://localhost:8000"
OPS_CORE_TIMEOUT_SECONDS=10.0
# Total attempts per call, including the first. Small: a prospect is waiting.
OPS_CORE_MAX_ATTEMPTS=3

# +--------------------------------------------------------------------------+
# | DIALOGUE LLM                                                              |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.llm.LLMSettings.
# Provider profile: openai | openai_compatible | ollama
# The model must be able to return a JSON object (response_format=json_object);
# every modern chat model can. A tiny model will still work — the control parser
# tolerates the odd malformed turn and re-asks.
LLM_PROVIDER="ollama"
LLM_MODEL="qwen2.5:7b"
# LLM_API_KEY="your_api_key"          # required only for provider="openai"
# Inside docker compose use host.docker.internal; outside use localhost.
LLM_BASE_URL="http://localhost:11434/v1"
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
# A little warmth reads more naturally than a flat, deterministic sales pitch.
LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024

# +--------------------------------------------------------------------------+
# | AGENT PERSONA & GUARD RAILS                                               |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.agent.SalesAgentSettings.
AGENT_NAME="Alex"
AGENT_COMPANY="Aurora Wellness"
# Conversation language: en | ru
AGENT_LANGUAGE="en"
# Past messages replayed to the model each turn (bounds prompt growth).
AGENT_HISTORY_LIMIT=20
# Consecutive unparseable turns before the agent stops re-asking and hands off to
# a human. Bounded so a misbehaving model can never wedge the conversation.
AGENT_MAX_PARSE_FAILURES=2

# +--------------------------------------------------------------------------+
# | CONVERSATION STORE  (in-memory, bounded)                                 |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.conversation.ConversationStoreSettings.
# Conversations live in process memory; these bounds stop it leaking. A
# conversation untouched for this long is evicted:
CONVERSATION_TTL_SECONDS=3600.0
# Hard cap on stored conversations; beyond it the least-recently-active is dropped.
CONVERSATION_MAX_ENTRIES=10000

# +--------------------------------------------------------------------------+
# | LOGGING                                                                  |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.logging.LoggingSettings.
LOG_LEVEL="INFO"            # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"           # json (production) | text (local development)

# +--------------------------------------------------------------------------+
# | HTTP                                                                     |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.app.AppSettings. A list, so it is given as
# JSON. Defaults to ["*"] — restrict it in production.
# CORS_ALLOW_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# Per-IP cap on POST /sales-agent/turn. Every turn is a paid LLM call, so this
# bounds both abuse and spend.
TURN_RATE_LIMIT_PER_MINUTE=30

# Inbound auth. Leave UNSET and the turn endpoint is open (handy for the local
# demo). Set it and every turn must carry a matching X-API-Key header. Set this
# before exposing the service publicly.
# INBOUND_API_KEY="choose-a-long-random-secret"
