    "default_detail": "Too many requests. Please slow down and retry shortly."
  },
  "slot_capacity_exceeded": {
    "exception": "SlotCapacityExceededError",
    "status_code": 409,
    "default_detail": "Party size exceeds the capacity of this slot."
  },
  "slot_unavailable": {
    "exception": "SlotUnavailableError",
    "status_code": 409,
