{
  "app_error": {
    "exception": "BaseAppException",
    "status_code": 500,
    "default_detail": "Application error."
  },
  "embedding_configuration_error": {
    "exception": "EmbeddingConfigurationError",
    "status_code": 500,
    "default_detail": "Embedding operation failed."
  },
  "embedding_error": {
    "exception": "EmbeddingError",
    "status_code": 500,
    "default_detail": "Embedding operation failed."
  },
  "embedding_generation_error": {
    "exception": "EmbeddingGenerationError",
    "status_code": 502,
    "default_detail": "Embedding provider request failed."
  },
  "embedding_input_error": {
    "exception": "EmbeddingInputError",
    "status_code": 422,
    "default_detail": "Embedding operation failed."
  },
  "embedding_model_mismatch": {
    "exception": "EmbeddingModelMismatchError",
    "status_code": 500,
    "default_detail": "Stored embeddings were produced by a different model."
  },
  "entity_not_found": {
    "exception": "EntityNotFoundError",
